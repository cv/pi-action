{"format":1,"seq":70,"writes":[{"type":"document.change","id":2,"content":{"version":3,"kind":"delta","ops":[["p",["generation","message","content"],1,0,[{"type":"toolCall","id":"toolu_bdrk_017xRSzcEX4uEYT9r7do2ife","name":"typescript","arguments":{"code":"async"}}]],["a",["generation","message","content",0,"thinkingSignature"],""],["a",["generation","message","content",1,"arguments","code"]," ({ shell: { exec } }, p: any) => {\n  const script = `\nconst fs=require('fs');\nconst res=${JSON.stringify(p)};\nfor (const [f, picks] of Object.entries(res)) {\n  let t=fs.readFileSync(f,'utf8'); let i=0;\n  t=t.replace(/<<<<<<< HEAD\\\\n([\\\\s\\\\S]*?)=======\\\\n([\\\\s\\\\S]*?)>>>>>>> [^\\\\n]*\\\\n/g,(m,a,b)=>{const r=picks[i++]; if(r==='ours')return a; if(r==='theirs')return b; if(r==='both')return a+b; return r;});\n  if(i!==picks.length) throw new Error(f+' count '+i);\n  fs.writeFileSync(f,t);\n}`;\n  return exec(`node -e ${JSON.stringify(script).replace(/^\"|\"$/g,\"'\").replace(/\\\\\"/g,'\"')}`);\n}"]]}}]}