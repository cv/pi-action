{
	"name": "pi-action",
	"version": "1.7.0",
	"description": "GitHub Action to invoke the pi coding agent on issues and PRs",
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"check": "biome check --error-on-warnings . && npm run lint:actions && npm run lint:shell",
		"fix": "biome check --write .",
		"lint:actions": "node scripts/lint-actions.mjs",
		"lint:shell": "shellcheck scripts/*.sh",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"prepare": "prek install --allow-missing-config --hook-type pre-commit --hook-type commit-msg --hook-type prepare-commit-msg --hook-type pre-push"
	},
	"keywords": [
		"github-action",
		"pi",
		"ai",
		"coding-agent",
		"automation"
	],
	"author": "Carlos Villela",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cv/pi-action.git"
	},
	"bugs": {
		"url": "https://github.com/cv/pi-action/issues"
	},
	"homepage": "https://github.com/cv/pi-action#readme",
	"engines": {
		"node": ">=25.0.0"
	},
	"dependencies": {
		"@actions/artifact": "^6.2.1",
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@mariozechner/pi-coding-agent": "^0.70.6",
		"tsx": "^4.21.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@commitlint/cli": "^20.5.2",
		"@commitlint/config-conventional": "^20.5.0",
		"@j178/prek": "^0.3.11",
		"@octokit/webhooks-types": "^7.6.1",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4.1.5",
		"actionlint": "^2.0.6",
		"shellcheck": "^3.1.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
