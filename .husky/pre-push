#!/bin/sh

echo "🔍 Running pre-push checks..."

# Run tests with coverage and enforce threshold
npm run coverage || {
    echo ""
    echo "❌ ERROR: Tests failed or coverage threshold not met!"
    echo ""
    echo "Ensure all tests pass and coverage meets the thresholds in vitest.config.ts."
    echo ""
    exit 1
}

echo "✅ Pre-push checks passed!"
