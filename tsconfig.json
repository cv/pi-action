{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true
	},
	"include": ["src/**/*"],
	"exclude": [
		"src/**/*.test.ts",
		"src/test-helpers.ts",
		"src/vendor/**/test-repo.ts"
	]
}
